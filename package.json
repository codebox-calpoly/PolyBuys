{
  "name": "polybuys",
  "version": "1.0.0",
  "description": "A marketplace for verified Cal Poly students to buy and sell their belongings",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "lint": "./scripts/lint.sh",
    "format": "./scripts/format.sh",
    "build": "npm run build --workspaces --if-present",
    "build:vercel": "cd backend && npx convex deploy --cmd-url-env-var-name EXPO_PUBLIC_CONVEX_URL --cmd 'cd ../frontend && npm run build'",
    "test": "jest",
    "test:watch": "jest --watch",
    "clean": "rm -rf node_modules frontend/node_modules backend/node_modules packages/shared/node_modules",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prepare": "node -e \"if (process.env.CI !== '1' && process.env.VERCEL !== '1') { require('child_process').execSync('husky', {stdio: 'inherit'}) }\""
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/preset-env": "^7.28.6",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "babel-jest": "^30.2.0",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-native": "^4.1.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "react-native-reanimated": "4.2.1",
    "react-native-worklets": "0.7.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.19.4",
    "npm": ">=9.0.0"
  },
  "volta": {
    "node": "20.19.4",
    "npm": "10.8.0"
  },
  "overrides": {
    "react-native-reanimated": "4.2.1",
    "react-native-worklets": "0.7.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "convex": "^1.32.0"
  }
}
