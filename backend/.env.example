# Convex Cloud Configuration
# Copy this file to .env.local and fill in the values
# DO NOT commit .env.local to git!

# Convex deployment slug.
# Generated automatically by `npx convex dev` in the backend workspace.
# Example: CONVEX_DEPLOYMENT=dev:polybuys-123
CONVEX_DEPLOYMENT=dev:your-convex-deployment

# Convex deployment URL.
# Generated automatically alongside CONVEX_DEPLOYMENT by `npx convex dev`.
CONVEX_URL=https://your-deployment.convex.cloud

# Public site URL used by auth/provider callbacks.
# In production this should match your Vercel domain or custom domain.
CONVEX_SITE_URL=https://polybuys.com

# Authentication Secrets
# Required for production email OTP authentication.
AUTH_RESEND_KEY=re_xxxxxxxxxxxxx
AUTH_RESEND_FROM=PolyBuys <noreply@polybuys.com>
# Optional App Review OTP (8-digit code)
# AUTH_APP_REVIEW_EMAIL=ios@polybuys.com
# AUTH_APP_REVIEW_CODE=31415926

# OpenAI Moderation API (free, used for content screening)
OPENAI_API_KEY=
