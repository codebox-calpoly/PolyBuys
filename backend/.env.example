# Self-hosted Convex Configuration
# Copy this file to .env.local and fill in the values
# DO NOT commit .env.local to git!

# Self-hosted Convex backend URL (Railway deployment)
CONVEX_SELF_HOSTED_URL=https://api.polybuys.com

# Self-hosted Convex actions URL (HTTP actions and webhooks)
CONVEX_SELF_HOSTED_ACTIONS_URL=https://actions.polybuys.com

# Admin key for self-hosted Convex (get from tech leads)
CONVEX_SELF_HOSTED_ADMIN_KEY=your-admin-key-here

# Authentication Secrets
AUTH_RESEND_KEY=your-resend-api-key-here

# OpenAI Moderation API (free, used for content screening)
OPENAI_API_KEY=your-openai-api-key-here

