{
  "expo": {
    "name": "PolyBuy",
    "slug": "polybuy",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android", "web"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.polybuy.app",
      "associatedDomains": ["applinks:polybuys.com"]
    },
    "android": {
      "package": "com.polybuy.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "polybuys.com",
              "pathPrefix": "/listings"
            },
            {
              "scheme": "https",
              "host": "polybuys.com",
              "pathPrefix": "/l"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://polybuys.com"
        }
      ],
      "expo-font"
    ],
    "scheme": "polybuys",
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro"
    }
  }
}
