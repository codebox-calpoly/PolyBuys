{
  "expo": {
    "name": "PolyBuy",
    "slug": "polybuy",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android", "web"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.polybuys.polybuys",
      "associatedDomains": ["applinks:polybuys.com"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.polybuys.polybuys",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "polybuys.com",
              "pathPrefix": "/listings"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://polybuys.com"
        }
      ],
      "expo-font",
      "expo-notifications"
    ],
    "scheme": "polybuys",
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {
        "origin": "https://polybuys.com"
      },
      "eas": {
        "projectId": "1f42b24b-0dcd-4b44-84d5-f31b6ff08dae"
      }
    },
    "owner": "polybuys"
  }
}
