# Self-hosted Convex Configuration
# Copy this file to .env.local and fill in the values
# DO NOT commit .env.local to git!

# Self-hosted Convex backend URL (Railway deployment)
# The EXPO_PUBLIC_ prefix makes this available in the Expo app
EXPO_PUBLIC_CONVEX_URL=https://api.polybuys.com

# Authentication (if using Clerk, Auth0, etc.)
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Environment
EXPO_PUBLIC_ENV=development
